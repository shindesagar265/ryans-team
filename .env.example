# Frontend
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_BASE_PATH=/

# Set these with Apps Script Properties, never commit real values.
SPREADSHEET_ID=replace-with-google-sheet-id
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=swimwave-apps-script
AUTH_AUDIENCE=swimwave-portal
